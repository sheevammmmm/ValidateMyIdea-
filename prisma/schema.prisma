generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdeaStage {
  BACKLOG
  DISCOVERY
  TESTING
  VALIDATED
  ARCHIVED
}

enum ExperimentType {
  LANDING_PAGE
  ADS
  INTERVIEWS
  EMAIL_CAMPAIGN
  PROTOTYPE
  OTHER
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  ideas     Idea[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Idea {
  id          String       @id @default(cuid())
  title       String
  problem     String
  audience    String?
  stage       IdeaStage    @default(BACKLOG)
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  experiments Experiment[]
  feedback    Feedback[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Experiment {
  id          String           @id @default(cuid())
  ideaId      String
  idea        Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  type        ExperimentType
  hypothesis  String
  targetMetric String?
  status      ExperimentStatus @default(PLANNED)
  startsAt    DateTime?
  endsAt      DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  ideaId     String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  source    String
  sentiment Int?
  summary   String
  createdAt DateTime @default(now())
}
